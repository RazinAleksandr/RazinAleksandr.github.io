---
import "../styles/global.css";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  /** Hides the big name in the nav on the home page, where the hero has it. */
  bare?: boolean;
}

const {
  title = profile.name,
  description = `${profile.name} — ${profile.role} at ${profile.org}, ${profile.location}. ${profile.tagline}`,
  bare = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${p}`.replace(/\/{2,}/g, "/");

const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E" +
  "%3Crect width='32' height='32' rx='7' fill='%230E1113'/%3E" +
  "%3Crect x='6' y='6' width='8.5' height='8.5' rx='2' fill='%230885A1'/%3E" +
  "%3Crect x='17.5' y='6' width='8.5' height='8.5' rx='2' fill='%23E0A32E'/%3E" +
  "%3Crect x='6' y='17.5' width='8.5' height='8.5' rx='2' fill='%23AF363C'/%3E" +
  "%3Crect x='17.5' y='17.5' width='8.5' height='8.5' rx='2' fill='%23469449'/%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0E1113" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#DCDAD3" media="(prefers-color-scheme: light)" />
    <link rel="icon" href={favicon} />
    <link rel="sitemap" href={href("sitemap-index.xml")} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(href("portrait.jpg"), Astro.site)} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,400..800&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />

    <script is:inline>
      // Set the theme before first paint so the page never flashes the wrong one.
      try {
        var t = localStorage.getItem("site-theme");
        if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    </script>
  </head>

  <body>
    <header class="nav">
      <div class="wrap navin">
        <a class="home" href={href("")}>
          {bare ? <span class="mark">A. RAZIN</span> : <span class="mark">A. RAZIN</span>}
        </a>
        <nav class="links">
          <a href={href("#work")}>work</a>
          <a href={href("#papers")}>papers</a>
          <a href={href("#projects")}>projects</a>
          <a href={href("blog")} class="blog">blog →</a>
        </nav>
        <button class="tgl" id="themeBtn" type="button" aria-pressed="false">Daylight</button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <p class="tagline">{profile.tagline}</p>
        <div class="linkrow">
          <a href={profile.links.github} target="_blank" rel="noopener">GitHub</a>
          <a href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={profile.links.scholar} target="_blank" rel="noopener">Scholar</a>
          <a href={profile.links.telegram} target="_blank" rel="noopener">Telegram</a>
          <a href={`mailto:${profile.email}`}>Email</a>
        </div>
        <p class="mono colophon">
          Palette calibrated to an X-Rite ColorChecker · portrait decoded from a latent
        </p>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const btn = document.getElementById("themeBtn");
      const isLight = () => {
        const t = root.getAttribute("data-theme");
        if (t === "light") return true;
        if (t === "dark") return false;
        return matchMedia("(prefers-color-scheme: light)").matches;
      };
      const paint = () => {
        if (!btn) return;
        btn.textContent = isLight() ? "Darkroom" : "Daylight";
        btn.setAttribute("aria-pressed", isLight() ? "true" : "false");
      };
      paint();
      btn?.addEventListener("click", () => {
        const next = isLight() ? "dark" : "light";
        root.setAttribute("data-theme", next);
        try { localStorage.setItem("site-theme", next); } catch (e) {}
        paint();
      });
    </script>
  </body>
</html>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule-soft);
  }
  .navin {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-block: 11px;
  }
  .home { text-decoration: none; }
  .mark {
    font-family: var(--font-m);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .17em;
    color: var(--ink);
  }
  .links {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
    flex-wrap: wrap;
  }
  .links a {
    font-family: var(--font-m);
    font-size: 11px;
    letter-spacing: .07em;
    text-decoration: none;
    color: var(--ink-3);
    padding: 5px 9px;
    border-radius: 999px;
  }
  .links a:hover { color: var(--ink); }
  .links a.blog {
    color: var(--ink);
    border: 1px solid var(--accent);
    box-shadow: 0 0 14px -6px var(--accent);
  }
  .links a.blog:hover { background: var(--accent); color: var(--accent-ink); }

  .tgl {
    font-family: var(--font-m);
    font-size: 9.5px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-2);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 5px 10px;
    cursor: pointer;
    white-space: nowrap;
  }
  .tgl:hover { color: var(--ink); border-color: var(--accent); }

  @media (max-width: 560px) {
    .links a { padding: 5px 7px; font-size: 10px; }
    .tgl { display: none; }
  }

  .foot {
    margin-top: 60px;
    border-top: 1px solid var(--rule-soft);
    padding-block: 34px 48px;
    text-align: center;
  }
  .foot .linkrow { justify-content: center; margin-top: 16px; }
  .tagline { margin: 0; color: var(--ink-2); font-size: 15px; }
  .colophon { margin: 20px 0 0; font-size: 9.5px; letter-spacing: .08em; }
</style>
