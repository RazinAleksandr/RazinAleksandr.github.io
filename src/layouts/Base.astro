---
import "../styles/global.css";
import { profile } from "../data/profile";
import Portrait from "../components/Portrait.astro";
import Icon from "../components/Icon.astro";

interface Props {
  title?: string;
  description?: string;
  /** Which nav entry is current: "home" | "cv" | "blog". */
  current?: string;
}

const {
  title = profile.name,
  description = `${profile.name} — ${profile.role} at ${profile.org}, ${profile.location}. ${profile.tagline}`,
  current = "home",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${p}`.replace(/\/{2,}/g, "/");
const portrait = href("portrait-900.jpg");

const sections = [
  ["about", "About"],
  ["news", "News"],
  ["experience", "Experience"],
  ["publications", "Publications"],
  ["projects", "Projects"],
];

const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E" +
  "%3Crect width='32' height='32' rx='6' fill='%23faf9f7'/%3E" +
  "%3Ctext x='16' y='22' font-family='Georgia,serif' font-weight='600' font-size='18' text-anchor='middle' fill='%23c8102e'%3EAR%3C/text%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131010" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={favicon} />
    <link rel="sitemap" href={href("sitemap-index.xml")} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(href("portrait.jpg"), Astro.site)} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=STIX+Two+Text:ital,wght@0,400;0,600;1,400&display=swap" />

    <script is:inline>
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    </script>
  </head>

  <body>
    <div class="layout">
      <aside class="side">
        <a class="photo" href={href("")} aria-label="Home">
          <Portrait src={portrait} alt={`Portrait of ${profile.name}`} />
        </a>

        <div class="who">
          <h1 class="name"><a href={href("")}>{profile.name}</a></h1>
          <p class="role">{profile.role}, <a href={profile.orgHref} target="_blank" rel="noopener">{profile.org}</a></p>
          <p class="where mono">{profile.location}</p>
        </div>

        <ul class="contacts">
          <li><a href={`mailto:${profile.email}`}><Icon name="mail" /> <span class="long">{profile.email}</span><span class="short">Email</span></a></li>
          <li><a href={profile.links.scholar} target="_blank" rel="noopener"><Icon name="scholar" size={15} /> Google Scholar</a></li>
          <li><a href={profile.links.github} target="_blank" rel="noopener"><Icon name="github" size={15} /> GitHub</a></li>
          <li><a href={profile.links.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" size={14} /> LinkedIn</a></li>
          <li><a href={profile.links.telegram} target="_blank" rel="noopener"><Icon name="telegram" size={15} /> Telegram</a></li>
        </ul>

        <nav class="nav" aria-label="Site">
          <ul>
            {sections.map(([id, label]) => (
              <li><a href={current === "home" ? `#${id}` : href(`#${id}`)}>{label}</a></li>
            ))}
          </ul>
          <ul class="pages">
            <li><a href={href("cv")} aria-current={current === "cv" ? "page" : undefined}><Icon name="file" size={15} /> CV</a></li>
            <li><a href={href("blog")} aria-current={current === "blog" ? "page" : undefined}><Icon name="pen" size={15} /> Blog</a></li>
          </ul>
        </nav>

        <button class="theme" id="themeBtn" type="button" aria-label="Toggle light or dark theme">
          <Icon name="moon" size={15} class="ic-moon" />
          <Icon name="sun" size={15} class="ic-sun" />
        </button>
      </aside>

      <main class="main">
        <slot />
        <footer class="foot">
          <span>© {new Date().getFullYear()} {profile.name}</span>
          <a href="https://github.com/RazinAleksandr/RazinAleksandr.github.io" target="_blank" rel="noopener">Source</a>
        </footer>
      </main>
    </div>

    <script>
      const root = document.documentElement;
      const btn = document.getElementById("themeBtn");
      const isDark = () => {
        const t = root.getAttribute("data-theme");
        return t ? t === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
      };
      btn?.addEventListener("click", () => {
        const next = isDark() ? "light" : "dark";
        root.setAttribute("data-theme", next);
        try { localStorage.setItem("theme", next); } catch (e) {}
      });
    </script>
  </body>
</html>

<style>
  .layout {
    display: grid;
    grid-template-columns: var(--side) minmax(0, 1fr);
    max-width: 1120px;
    margin-inline: auto;
    padding-inline: 24px;
    gap: 64px;
  }

  /* ---- sidebar ---- */
  .side {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100vh;
    height: 100dvh;
    overflow-y: auto;
    padding-block: 44px 28px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    scrollbar-width: none;
  }
  .side::-webkit-scrollbar { display: none; }

  .photo { display: block; width: 100%; max-width: 232px; }

  .name { font-size: 28px; font-weight: 600; line-height: 1.15; }
  .name a { color: var(--ink); }
  .name a:hover { text-decoration: none; }
  .role { margin-top: 6px; font-size: 15px; color: var(--muted); line-height: 1.45; }
  .role a { color: var(--ink); }
  .where { margin-top: 4px; }

  .contacts, .nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; }
  .contacts a, .nav a {
    display: inline-flex; align-items: center; gap: 9px;
    color: var(--ink); font-size: 14.5px; line-height: 1.3;
  }
  .contacts a { color: var(--muted); }
  .contacts a:hover, .nav a:hover { color: var(--accent); text-decoration: none; }
  .contacts svg, .nav svg { color: var(--faint); flex: none; }
  .contacts .short { display: none; }
  .contacts a:hover svg, .nav a:hover svg { color: var(--accent); }

  .nav { padding-top: 18px; border-top: 1px solid var(--line); display: grid; gap: 14px; }
  .nav .pages { padding-top: 14px; border-top: 1px solid var(--line); }
  .nav a[aria-current="page"] { color: var(--accent); }
  .nav a[aria-current="page"] svg { color: var(--accent); }

  .theme {
    margin-top: auto;
    width: 32px; height: 32px;
    display: grid; place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: var(--card);
    color: var(--muted);
    cursor: pointer;
  }
  .theme:hover { color: var(--accent); }
  .theme :global(.ic-sun) { display: none; }
  :global(:root[data-theme="dark"]) .theme :global(.ic-moon) { display: none; }
  :global(:root[data-theme="dark"]) .theme :global(.ic-sun) { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme :global(.ic-moon) { display: none; }
    :global(:root:not([data-theme="light"])) .theme :global(.ic-sun) { display: block; }
  }

  /* ---- main ---- */
  .main {
    max-width: var(--measure);
    padding-block: 52px 40px;
    min-width: 0;
  }
  .foot {
    margin-top: 48px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    display: flex; gap: 18px;
    font-size: 13px; color: var(--faint);
  }
  .foot a { color: var(--faint); }
  .foot a:hover { color: var(--accent); }

  /* ---- narrow: the sidebar becomes a header ---- */
  @media (max-width: 860px) {
    .layout { grid-template-columns: 1fr; gap: 0; padding-inline: 20px; }
    .side {
      position: static; height: auto; overflow: visible;
      padding-block: 28px 0;
      display: grid;
      grid-template-columns: 96px minmax(0, 1fr);
      grid-template-areas: "photo who" "contacts contacts" "nav nav";
      column-gap: 18px; row-gap: 18px;
      align-items: center;
    }
    .photo { grid-area: photo; max-width: 96px; }
    .who { grid-area: who; }
    .name { font-size: 24px; }
    .contacts { grid-area: contacts; display: flex; flex-wrap: wrap; gap: 6px 16px; }
    .contacts .long { display: none; }
    .contacts .short { display: inline; }
    .nav { grid-area: nav; padding-top: 14px; }
    .nav ul { display: flex; flex-wrap: wrap; gap: 6px 16px; }
    .nav .pages { padding-top: 0; border-top: 0; }
    .theme { position: fixed; right: 16px; bottom: 16px; z-index: 10; box-shadow: var(--shadow); }
    .main { padding-top: 36px; }
  }
</style>
