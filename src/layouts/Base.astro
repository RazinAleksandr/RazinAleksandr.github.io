---
import "../styles/global.css";
import { profile } from "../data/profile";
import Icon from "../components/Icon.astro";

interface Props { title?: string; description?: string; current?: string }
const {
  title = profile.name,
  description = `${profile.name} — ${profile.role} at ${profile.org}. ${profile.tagline}`,
  current = "home",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${p}`.replace(/\/{2,}/g, "/");
const home = current === "home";

const nav = [
  ["papers", "Papers", home ? "#papers" : href("#papers")],
  ["projects", "Projects", home ? "#projects" : href("#projects")],
  ["news", "News", home ? "#news" : href("#news")],
  ["cv", "CV", href("cv")],
  ["blog", "Blog", href("blog")],
];

const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E" +
  "%3Crect width='32' height='32' fill='%23f3f0e8'/%3E%3Ccircle cx='16' cy='16' r='7' fill='%231f3bd6'/%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f0e8" />
    <link rel="icon" href={favicon} />
    <link rel="sitemap" href={href("sitemap-index.xml")} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(href("portrait.jpg"), Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
  </head>

  <body>
    <header class="top">
      <div class="wrap bar">
        <a class="label home" href={href("")}>{profile.name}</a>
        <nav class="label" aria-label="Site">
          {nav.map(([id, text, url]) => (
            <a href={url} aria-current={current === id ? "page" : undefined}>{text}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="wrap foot">
      <div class="row">
        <a class="mail" href={`mailto:${profile.email}`}>{profile.email}</a>
        <div class="social">
          <a href={profile.links.scholar} target="_blank" rel="noopener" aria-label="Google Scholar"><Icon name="scholar" size={15} /></a>
          <a href={profile.links.github} target="_blank" rel="noopener" aria-label="GitHub"><Icon name="github" size={15} /></a>
          <a href={profile.links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" size={14} /></a>
          <a href={profile.links.telegram} target="_blank" rel="noopener" aria-label="Telegram"><Icon name="telegram" size={15} /></a>
        </div>
      </div>
      <p class="label">© {new Date().getFullYear()} {profile.name} · {profile.location}</p>
    </footer>
  </body>
</html>

<style>
  .top {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
  }
  .bar {
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    height: 56px;
    border-bottom: 1px solid var(--line);
  }
  .home { color: var(--ink); white-space: nowrap; }
  nav { display: flex; gap: 22px; }
  nav a { color: var(--muted); padding: 4px 0; transition: color .15s; }
  nav a:hover, nav a[aria-current="page"] { color: var(--ink); }
  nav a[aria-current="page"] { box-shadow: inset 0 -1px 0 var(--ink); }

  .foot { padding-block: 40px 48px; border-top: 1px solid var(--line); display: grid; gap: 14px; }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .mail { font-family: var(--serif); font-size: 26px; letter-spacing: -.01em; color: var(--ink); }
  .mail:hover { color: var(--accent); }
  .social { display: flex; gap: 6px; }
  .social a {
    width: 34px; height: 34px; display: grid; place-items: center;
    border: 1px solid var(--line); border-radius: 50%; color: var(--ink-2);
    transition: color .15s, border-color .15s;
  }
  .social a:hover { color: var(--accent); border-color: var(--accent); }

  @media (max-width: 600px) {
    nav { gap: 14px; }
    .mail { font-size: 21px; }
  }
</style>
