---
import "../styles/global.css";
import { profile } from "../data/profile";
import Portrait from "../components/Portrait.astro";
import Icon from "../components/Icon.astro";
import PageViews from "../components/PageViews.astro";

interface Props { title?: string; description?: string; current?: string }
const {
  title = profile.name,
  description = `${profile.name} — ${profile.role} at ${profile.org}. ${profile.tagline}`,
  current = "home",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${p}`.replace(/\/{2,}/g, "/");
const home = current === "home";
// the profile column stays beside the CV too, so the CV reads as a panel of
// this page rather than a place you navigate away to
const withSide = home || current === "cv";
const portrait = href("portrait-900.jpg");
const productionSite = Astro.site!;
const route = Astro.url.pathname;
const canonical = new URL(`${route.replace(/\/$/, "")}/`, productionSite).href;
const personId = new URL("/#person", productionSite).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": home ? "ProfilePage" : "WebPage",
  "@id": `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  ...(home ? {
    mainEntity: {
      "@type": "Person",
      "@id": personId,
      name: profile.name,
      givenName: profile.first,
      familyName: profile.last,
      url: productionSite.href,
      image: new URL("/portrait.jpg", productionSite).href,
      jobTitle: profile.role,
      worksFor: { "@type": "Organization", name: profile.org, url: profile.orgHref },
      sameAs: Object.values(profile.links),
    },
  } : { about: { "@id": personId } }),
};
const googleVerification = import.meta.env.GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.BING_SITE_VERIFICATION;

// The GA4 property the Jekyll site reported to, so the history continues in
// the same place. Loaded in production only: a dev server left open all day
// would otherwise file every reload as a visit.
const GA = "G-QX68KTT819";


const nav = [
  ["home", "Profile", href("")],
  ["news", "News", home ? "#news" : href("#news")],
  ["awards", "Awards", home ? "#awards" : href("#awards")],
  ["papers", "Papers", home ? "#papers" : href("#papers")],
  ["projects", "Projects", home ? "#projects" : href("#projects")],
  ["cv", "CV", href("cv")],
];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
    <meta name="theme-color" content="#120a1c" />
    <link rel="icon" type="image/png" sizes="32x32" href={href("icon-32.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={href("icon-180.png")} />
    <link rel="sitemap" href={href("sitemap-index.xml")} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(href("portrait.jpg"), Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=JetBrains+Mono:wght@400;500&display=swap" />

    {import.meta.env.PROD && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA}`}></script>
        <script is:inline define:vars={{ GA }}>
          // define:vars wraps this in a function, so gtag is published on
          // window by hand — the usual snippet leaves it global, and anything
          // added later will expect to find it there.
          window.dataLayer = window.dataLayer || [];
          window.gtag = function gtag() { window.dataLayer.push(arguments); };
          window.gtag("js", new Date());
          window.gtag("config", GA);
        </script>
      </>
    )}
  </head>

  <body>
    <header class="top">
      <nav class="wrap topnav label" aria-label="Site">
        {nav.map(([id, text, url]) => (
          <a href={url} aria-current={current === id ? "page" : undefined}>{text}</a>
        ))}
      </nav>
    </header>

    <div class:list={["wrap", "layout", !withSide && "single"]}>
      {withSide && <aside class="side">
        <div class="photo">
          <a href={href("")} aria-label="Home">
            <Portrait src={portrait} alt={`Portrait of ${profile.name}`} />
          </a>
          <PageViews />
        </div>
        <h1 class="name">{profile.name}</h1>
        <p class="role">{profile.role} · <a href={profile.orgHref} target="_blank" rel="noopener">{profile.org}</a></p>
        <p class="where label">{profile.location}, Bulgaria</p>

        <ul class="contacts">
          <li><a href={`mailto:${profile.email}`}><Icon name="mail" size={15} /> {profile.email}</a></li>
          <li><a href={profile.links.scholar} target="_blank" rel="noopener"><Icon name="scholar" size={15} /> Google Scholar</a></li>
          <li><a href={profile.links.github} target="_blank" rel="noopener"><Icon name="github" size={15} /> GitHub</a></li>
          <li><a href={profile.links.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" size={14} /> LinkedIn</a></li>
          <li><a href={profile.links.x} target="_blank" rel="noopener"><Icon name="x" size={15} /> X / Twitter</a></li>
          <li><a href={profile.links.telegram} target="_blank" rel="noopener"><Icon name="telegram" size={15} /> Telegram</a></li>
        </ul>
      </aside>}

      <main class="main">
        <slot />
        <footer class="foot label">© {new Date().getFullYear()} {profile.name}</footer>
      </main>
    </div>
  </body>
</html>

<style>
  .wrap { max-width: var(--w); margin-inline: auto; padding-inline: var(--gutter); }

  .top { position: sticky; top: 0; z-index: 20; background: rgba(18, 10, 28, .55); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .topnav { display: flex; gap: 26px; height: 52px; align-items: center; overflow-x: auto; scrollbar-width: none; }
  .topnav::-webkit-scrollbar { display: none; }
  .topnav a { color: var(--muted); white-space: nowrap; }
  .topnav a:hover, .topnav a[aria-current="page"] { color: var(--ink); }
  .topnav a:first-child {
    color: var(--ink);
    padding: 5px 12px; margin-left: -12px;
    border: 1px solid var(--line-2); border-radius: 999px;
  }
  .topnav a:first-child:hover { border-color: var(--rose); color: var(--rose); }

  .layout {
    display: grid;
    grid-template-columns: var(--side) minmax(0, 1fr);
    gap: 64px;
    padding-top: 44px;
  }
  /* pages other than the profile: one column, the profile is a click away */
  .layout.single { grid-template-columns: minmax(0, 1fr); max-width: 880px; }

  .side {
    position: sticky; top: 76px; align-self: start;
    display: grid; gap: 6px; justify-items: start;
  }
  .photo { position: relative; display: block; width: 100%; margin-bottom: 14px; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); }
  .photo > a { display: block; }
  .name { font-size: 34px; font-weight: 500; }
  .role { font-size: 17px; color: var(--ink-2); }
  .role a { color: var(--ink); }
  .role a:hover { color: var(--rose); }
  .where { margin-top: 2px; }

  .contacts { margin-top: 22px; display: grid; gap: 8px; }
  .contacts a { display: inline-flex; align-items: center; gap: 10px; color: var(--ink-2); font-size: 16px; }
  .contacts a:hover { color: var(--rose); }
  .contacts svg { color: var(--accent); flex: none; }

  .main { min-width: 0; padding-bottom: 40px; }
  .foot { margin-top: 56px; padding-top: 18px; border-top: 1px solid var(--line); }

  @media (max-width: 880px) {
    .layout { grid-template-columns: 1fr; gap: 28px; padding-top: 28px; }
    .side {
      position: static;
      grid-template-columns: 112px minmax(0, 1fr);
      grid-template-areas: "photo name" "photo role" "photo where" "contacts contacts";
      column-gap: 18px; align-items: center;
    }
    .photo { grid-area: photo; margin: 0; }
    .name { grid-area: name; font-size: 26px; align-self: end; }
    .role { grid-area: role; font-size: 15px; }
    .where { grid-area: where; align-self: start; }
    .contacts { grid-area: contacts; display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 8px; }
    .contacts a { font-size: 14.5px; }
  }
</style>
