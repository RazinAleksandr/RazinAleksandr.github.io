---
import { profile } from "../data/profile";
import { inlineMd } from "../lib/inline";
---

<section class="section" id="about">
  <h2>About</h2>
  <div class="prose">
    {profile.intro.map((p) => <p set:html={inlineMd(p)} />)}
  </div>
  <p class="interests">
    <span class="k">Interests</span>
    {profile.interests.join(" · ")}
  </p>
</section>

<style>
  .prose { display: grid; gap: 14px; font-size: 16.5px; line-height: 1.65; color: var(--ink); }
  .prose :global(strong) { font-weight: 600; }
  .interests { margin-top: 18px; font-size: 14.5px; color: var(--muted); }
  .interests .k { color: var(--faint); margin-right: 10px; font-family: var(--mono); font-size: 12.5px; }
</style>
