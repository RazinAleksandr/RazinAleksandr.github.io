---
/**
 * An organisation mark in a small square tile. Uses the SVG in public/logos/
 * when there is one, otherwise a serif monogram, so a row of them reads as
 * one set whether or not every company has a usable logo.
 */
interface Props { logo?: string; mark: string; title?: string; class?: string }
const { logo, mark, title, class: cls } = Astro.props;
const base = import.meta.env.BASE_URL;
const src = logo ? `${base}${logo}`.replace(/\/{2,}/g, "/") : undefined;
---

<span class:list={["tile", cls]} title={title} aria-hidden="true">
  {src ? <img src={src} alt="" width="18" height="18" /> : <span class="mono-mark">{mark}</span>}
</span>

<style>
  /* brand SVGs are black-on-transparent; recolour them to the ink so they
     follow the theme like everything else */
  .tile img {
    filter: brightness(0) saturate(100%) opacity(.85);
  }
  :global(:root[data-theme="dark"]) .tile img { filter: brightness(0) invert(1) opacity(.85); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .tile img { filter: brightness(0) invert(1) opacity(.85); }
  }
</style>
