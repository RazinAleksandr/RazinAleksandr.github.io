---
/**
 * One row, oldest on the left. Marks are drawn in ink at a common height and
 * take their own colour back on hover; nothing else is said about them here.
 */
import { orgs } from "../data/logos";
import Icon from "./Icon.astro";

const base = import.meta.env.BASE_URL;
const src = (p: string) => `${base}${p}`.replace(/\/{2,}/g, "/");
---

<section class="section band" aria-label="Where I've worked">
  <p class="label">Previously</p>
  <ul class="row">
    {orgs.map((o) => (
      <li>
        <a href={o.href} target="_blank" rel="noopener" title={`${o.name} · ${o.years}`}>
          {o.img ? (
            <img src={src(o.img)} alt={o.name} style={`aspect-ratio: ${o.ratio ?? 3}`} />
          ) : o.icon ? (
            <span class="mark"><Icon name={o.icon} size={22} /><span>{o.name}</span></span>
          ) : (
            <span class="word serif">{o.name}</span>
          )}
          <span class="mono years">{o.years}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .band { grid-template-columns: 1fr; gap: 22px; padding-block: 32px 40px; }
  .row {
    display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between;
    gap: 22px 36px;
  }
  .row a {
    display: grid; gap: 8px; justify-items: start;
    color: var(--ink);
  }
  .row img, .mark, .word { height: 26px; }
  .row img { width: auto; filter: grayscale(1) brightness(.35) contrast(1.2); opacity: .9; transition: filter .2s, opacity .2s; }
  .row a:hover img { filter: none; opacity: 1; }
  .mark {
    display: inline-flex; align-items: center; gap: 8px;
    font-weight: 600; font-size: 17px; letter-spacing: -.01em;
  }
  .mark svg { color: var(--ink); }
  .word { font-size: 24px; line-height: 26px; letter-spacing: -.01em; }
  .years { font-size: 11px; color: var(--muted); }
  .row a:hover .years { color: var(--accent); }

  @media (max-width: 700px) { .row { justify-content: flex-start; gap: 20px 32px; } }
</style>
