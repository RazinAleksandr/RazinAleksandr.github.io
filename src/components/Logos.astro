---
/**
 * Where I've worked as a running strip: oldest on the left, newest on the
 * right, starting over after the newest. Each stop is the mark, the dates as
 * MM.YYYY — MM.YYYY, and the title I held there. It pauses under the pointer;
 * with reduced motion it wraps.
 */
import { orgs } from "../data/logos";
import Icon from "./Icon.astro";

const base = import.meta.env.BASE_URL;
const src = (p: string) => `${base}${p}`.replace(/\/{2,}/g, "/");

/** "2025.04" → "04.2025"; "now" and anything else pass through */
const md = (d: string) => {
  const m = /^(\d{4})\.(\d{2})$/.exec(d);
  return m ? `${m[2]}.${m[1]}` : d;
};
const span = (o: (typeof orgs)[number]) => `${md(o.from)} — ${md(o.to)}`;
---

<section class="section" aria-label="Where I've worked">
  <p class="label">Previously</p>
  <div class="marquee">
    <ul class="track">
      {[0, 1].map((copy) =>
        orgs.map((o) => (
          <li aria-hidden={copy === 1 ? "true" : undefined}>
            <a class="stop" href={o.href} target="_blank" rel="noopener" tabindex={copy === 1 ? -1 : undefined}>
              <span class:list={["mark", o.brand && "brand"]}>
                {o.img ? (
                  <img src={src(o.img)} alt={o.name} class={!o.brand && o.img.endsWith(".png") ? "raster" : ""} style={`aspect-ratio: ${o.ratio ?? 3}`} />
                ) : o.emblem ? (
                  <><img class="emblem" src={src(o.emblem)} alt="" style="aspect-ratio: 1" /><span class="name">{o.name}</span></>
                ) : o.icon ? (
                  <><Icon name={o.icon} size={22} /><span class="name">{o.name}</span></>
                ) : (
                  <span class="word">{o.name}</span>
                )}
              </span>
              <span class="mono when">{span(o)}</span>
              <span class="role">{o.role}</span>
            </a>
          </li>
        ))
      )}
    </ul>
  </div>
</section>

<style>
  .section { padding-top: 34px; }
  .label { margin-bottom: 18px; }
  /* a real scroll container: the drift below is just scrollLeft, so the wheel,
     a trackpad swipe, a drag and a swipe on glass all work on the same axis */
  .marquee {
    overflow-x: auto;
    scroll-behavior: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    cursor: grab;
    -webkit-mask: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
            mask: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee::-webkit-scrollbar { display: none; }
  .marquee.dragging { cursor: grabbing; }
  .track { display: flex; width: max-content; gap: 64px; padding-right: 64px; }

  .stop { display: grid; gap: 7px; justify-items: start; color: var(--ink); white-space: nowrap; }
  /* every mark sits back until the pointer picks that stop out of the strip */
  .mark {
    height: 30px; display: inline-flex; align-items: center; gap: 8px;
    color: var(--ink); opacity: .58; transition: opacity .18s;
  }
  .stop:hover .mark, .stop:focus-visible .mark { opacity: 1; }
  /* a mark in its own colours is never held back — that is the point of it */
  .mark.brand { opacity: 1; }
  /* nothing to hover with on a touch screen — there the marks stay lit */
  @media (hover: none) { .mark { opacity: 1; } }
  .mark img { height: 26px; width: auto; }
  /* black-on-transparent wordmarks become cream on the dark ground */
  .mark img.raster { filter: grayscale(1) invert(1) brightness(1.05); opacity: .92; }
  /* a crest is square, so it needs the extra height to carry a wordmark's
     weight; flattened to cream, like every other mark in the strip */
  .mark img.emblem { height: 30px; filter: brightness(0) invert(1); opacity: .92; }
  .mark svg { color: var(--ink); }
  .name { font-family: var(--serif); font-weight: 600; font-size: 20px; }
  .word { font-size: 22px; line-height: 26px; }
  .when { color: var(--muted); }
  /* an empty role still holds its line, so every mark sits on the same baseline */
  .role { font-size: 15px; line-height: 1.2; color: var(--ink-2); min-height: 1.2em; }

  /* Where the strip does not drift — reduced motion, or a touch screen, where
     the drift fought the finger — one copy is enough. It stays a strip either
     way: still scrollable, just pushed by hand. Turning it into a wrapped
     block instead left nothing to move at all, which reads as broken. */
  @media (prefers-reduced-motion: reduce), (hover: none) {
    .track li[aria-hidden="true"] { display: none; }
    .track { padding-right: 0; }
  }
</style>

<script>
  /**
   * The strip drifts by its own scroll position rather than a transform, so
   * everything the browser already knows how to scroll — the wheel, a trackpad
   * swipe, a drag, a swipe on glass, the keyboard walking the links — moves it
   * too, and the drift gets out of the way while you are steering.
   *
   * The list is rendered twice, so one period is half the scrollable width.
   * Scrolling is kept inside [0, period): crossing either end and stepping back
   * by a period lands on the identical frame, which is what makes it endless in
   * both directions — scrollLeft itself can never go negative.
   */
  const box = document.querySelector<HTMLElement>(".marquee");
  const track = box?.querySelector<HTMLElement>(".track");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  // On a touch screen the drift and the finger fight over the same scroll
  // offset, and the finger loses: a swipe dies under the next frame's write.
  // There the strip simply doesn't drift — it is swiped, which is what a
  // horizontal list on a phone wants anyway.
  const coarse = matchMedia("(hover: none)").matches;

  if (box && track && !reduced && !coarse) {
    const PERIOD_SECONDS = 24;   // time to cross one copy, as the CSS took
    const RESUME = 1600;         // ms of stillness after a touch before drifting on
    const EDGE = 1;              // px of slack that keeps the two wraps apart

    // Reasons to stay still, each its own flag rather than one counter: a
    // counter only has to miss a single release — a touchcancel instead of a
    // touchend, a focusout that never comes — and the strip is stuck for good.
    let hovering = false, focused = false, dragging = false, touching = false;
    const held = () => hovering || focused || dragging || touching;

    box.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") hovering = true; });
    box.addEventListener("pointerleave", (e) => { if (e.pointerType === "mouse") hovering = false; });
    box.addEventListener("focusin", () => (focused = true));
    box.addEventListener("focusout", () => (focused = false));

    // A gesture the browser takes over for scrolling ends in touchcancel, not
    // touchend, so both have to let go.
    let touchTimer = 0;
    const touchOn = () => { clearTimeout(touchTimer); touching = true; };
    const touchOff = () => {
      clearTimeout(touchTimer);
      touchTimer = window.setTimeout(() => (touching = false), RESUME);
    };
    box.addEventListener("touchstart", touchOn, { passive: true });
    box.addEventListener("touchend", touchOff, { passive: true });
    box.addEventListener("touchcancel", touchOff, { passive: true });

    // drag with the mouse only: on glass the browser's own swipe and momentum win
    let startX = 0, startLeft = 0, moved = false;
    // what we left scrollLeft at, and until when someone else owns it
    let expected = -1, foreignUntil = 0;

    box.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse" || e.button !== 0) return;
      dragging = true; moved = false;
      // the drag takes the offset over outright, whatever was moving it before
      foreignUntil = 0;
      startX = e.clientX; startLeft = box.scrollLeft;
      box.setPointerCapture(e.pointerId);
      box.classList.add("dragging");
      e.preventDefault();          // no native link or image drag, no text selection
    });
    box.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 3) moved = true;

      // Wrap here rather than waiting for the next frame: a quick drag sends
      // moves faster than frames arrive, and each one recomputing from an
      // unwrapped startLeft would keep pinning the strip to the end it just hit.
      let next = startLeft - dx;
      const period = track!.scrollWidth / 2;
      if (period > box.clientWidth) {
        while (next < EDGE) { next += period; startLeft += period; }
        while (next > period + EDGE) { next -= period; startLeft -= period; }
      }
      box.scrollLeft = next;
      expected = box.scrollLeft;
    });
    const drop = () => {
      if (!dragging) return;
      dragging = false;
      box.classList.remove("dragging");
    };
    box.addEventListener("pointerup", drop);
    box.addEventListener("pointercancel", drop);
    // a drag that happens to end on a link must not also follow it
    box.addEventListener("click", (e) => {
      if (moved) { e.preventDefault(); e.stopPropagation(); }
    }, true);

    let raf = 0, last = 0, running = false;

    function frame(now: number) {
      if (!running) return;
      const dt = Math.min(now - last, 100);   // coming back to the tab should not lurch
      last = now;

      // If the strip is not where we left it, something else is driving: a
      // fling still coasting, a wheel, the keyboard walking the links. Touch
      // events cannot be relied on to say so — a fling outlives them — so this
      // reads the scroll position itself and simply gets out of the way.
      const actual = box!.scrollLeft;
      if (expected >= 0 && Math.abs(actual - expected) > 1.5) foreignUntil = now + 700;
      const steered = held() || now < foreignUntil;

      const period = track!.scrollWidth / 2;
      if (period > box!.clientWidth) {
        if (!steered) box!.scrollLeft += (period / PERIOD_SECONDS) * (dt / 1000);

        // The two copies are identical, so these seams are invisible — which is
        // also why the wrap can wait. Writing scrollLeft mid-fling kills the
        // fling, so while a finger is on the strip it is left alone and the
        // wrap happens once the gesture is over, unseen.
        //
        // The band is [EDGE, period + EDGE]: a step of exactly one period from
        // either end lands inside it. Were the two ends a period apart instead,
        // each wrap would trip the other one and the strip would sit there
        // flipping between them every frame.
        // A mouse drag sets the offset itself, so it can be wrapped under —
        // there is no fling to break. Only a scroll the browser owns is left
        // alone, and it wraps as soon as that settles.
        if (!touching && now >= foreignUntil) {
          if (box!.scrollLeft > period + EDGE) { box!.scrollLeft -= period; startLeft -= period; }
          else if (box!.scrollLeft < EDGE) { box!.scrollLeft += period; startLeft += period; }
        }
      }
      expected = box!.scrollLeft;
      raf = requestAnimationFrame(frame);
    }

    function start() {
      if (running || document.hidden) return;
      running = true;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    }
    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    const io = new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), { threshold: 0 });
    io.observe(box);
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
  }
</script>
