---
/**
 * Where I've worked as a running strip: oldest on the left, newest on the
 * right, starting over after the newest. Each stop is the mark, the name and
 * the dates. It pauses under the pointer; with reduced motion it wraps.
 */
import { orgs } from "../data/logos";
import Icon from "./Icon.astro";

const base = import.meta.env.BASE_URL;
const src = (p: string) => `${base}${p}`.replace(/\/{2,}/g, "/");
const when = (o: (typeof orgs)[number]) => `${o.from} — ${o.to}`;
---

<section class="section" aria-label="Where I've worked">
  <p class="label">Previously</p>
  <div class="marquee">
    <ul class="track">
      {[0, 1].map((copy) =>
        orgs.map((o) => (
          <li aria-hidden={copy === 1 ? "true" : undefined}>
            <a class="stop" href={o.href} target="_blank" rel="noopener" tabindex={copy === 1 ? -1 : undefined}>
              <span class="mark">
                {o.img ? (
                  <img src={src(o.img)} alt="" class={o.img.endsWith(".png") ? "raster" : ""} style={`aspect-ratio: ${o.ratio ?? 3}`} />
                ) : o.icon ? (
                  <><Icon name={o.icon} size={22} /><span class="name">{o.name}</span></>
                ) : (
                  <span class="word">{o.name}</span>
                )}
              </span>
              <span class="mono when">{when(o)}{o.role && <> · {o.role}</>}</span>
            </a>
          </li>
        ))
      )}
    </ul>
  </div>
</section>

<style>
  .section { padding-top: 34px; }
  .label { margin-bottom: 18px; }
  .marquee {
    overflow: hidden;
    -webkit-mask: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
            mask: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .track { display: flex; width: max-content; gap: 64px; padding-right: 64px; animation: run 40s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  @keyframes run { to { transform: translateX(-50%); } }

  .stop { display: grid; gap: 8px; justify-items: start; color: var(--ink); white-space: nowrap; }
  .mark { height: 26px; display: inline-flex; align-items: center; gap: 8px; color: var(--ink); }
  .mark img { height: 26px; width: auto; }
  /* black-on-transparent wordmarks become cream on the dark ground */
  .mark img.raster { filter: grayscale(1) invert(1) brightness(1.05); opacity: .92; }
  .mark svg { color: var(--ink); }
  .name { font-family: var(--serif); font-weight: 600; font-size: 20px; }
  .word { font-size: 22px; line-height: 26px; }
  .when { color: var(--muted); }
  .stop:hover .when { color: var(--rose); }

  @media (prefers-reduced-motion: reduce) {
    .marquee { mask: none; -webkit-mask: none; }
    .track { animation: none; width: auto; flex-wrap: wrap; gap: 22px 40px; padding-right: 0; }
    .track li[aria-hidden="true"] { display: none; }
  }
</style>
