---
import { news } from "../data/news";
import { inlineMd } from "../lib/inline";
---

<section class="section" id="news">
  <h2>News</h2>
  <ul class="news">
    {news.map((n) => (
      <li>
        <span class="date mono">{n.date}</span>
        <span class="body" set:html={inlineMd(n.body)} />
      </li>
    ))}
  </ul>
</section>

<style>
  .news { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .news li { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 14px; align-items: baseline; }
  .date { white-space: nowrap; }
  .body { font-size: 15.5px; line-height: 1.55; color: var(--ink); }
  .body :global(strong) { font-weight: 600; }
  .body :global(em) { font-family: var(--serif); font-style: italic; }
  .body :global(a) { color: var(--accent); }
  @media (max-width: 560px) {
    .news li { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
