---
import { news } from "../data/news";
import { inlineMd } from "../lib/inline";
---

<section class="section" id="news">
  <h2>News</h2>
  <ul class="news">
    {news.map((n) => (
      <li>
        <span class="mono date">{n.date}</span>
        <span class="body" set:html={inlineMd(n.body)} />
      </li>
    ))}
  </ul>
</section>

<style>
  .news { display: grid; gap: 10px; }
  .news li { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 16px; align-items: baseline; }
  .date { color: var(--accent); }
  .body { font-size: 17px; color: var(--ink-2); }
  .body :global(strong) { color: var(--ink); }
</style>
