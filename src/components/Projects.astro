---
/**
 * Repositories, one line each. Star counts come from the GitHub API at build
 * time and fall back to the snapshot in projects.ts when it is unreachable.
 */
import { projects } from "../data/projects";
import { liveStars } from "../lib/stars";
import Icon from "./Icon.astro";

const stars = await liveStars();
const owner = (p: (typeof projects)[number]) => p.owner ?? "RazinAleksandr";
const list = projects.map((p) => ({
  ...p,
  url: p.href ?? `https://github.com/${owner(p)}/${p.repo}`,
  count: p.owner ? p.stars : (stars[p.repo] ?? p.stars),
}));
---

<section class="section" id="projects">
  <p class="label">Projects</p>
  <ul class="list">
    {list.map((p) => (
      <li>
        <a class="row" href={p.url} target="_blank" rel="noopener">
          <span class="name">{p.name}</span>
          <span class="blurb">{p.blurb}</span>
          <span class="meta mono">
            {p.lang}
            {p.count > 0 && <><span class="sep">·</span><Icon name="star" size={11} /> {p.count}</>}
          </span>
          <Icon name="arrow" size={14} class="arrow" />
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .list { display: grid; }
  .list li { border-top: 1px solid var(--line); }
  .list li:first-child { border-top: 0; }
  .row {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) auto 14px;
    grid-template-areas: "name blurb meta arrow";
    gap: 6px 20px;
    align-items: baseline;
    padding: 14px 0;
    color: var(--ink);
  }
  .name { grid-area: name; }
  .blurb { grid-area: blurb; }
  .meta { grid-area: meta; }
  .row :global(.arrow) { grid-area: arrow; }
  .name { font-weight: 500; font-size: 15.5px; }
  .blurb { font-size: 14.5px; line-height: 1.5; color: var(--ink-2); }
  .meta { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; font-size: 12px; }
  .sep { margin: 0 4px; }
  .row :global(.arrow) { color: var(--line-2); transition: color .15s, transform .15s; align-self: center; }
  .row:hover .name { color: var(--accent); }
  .row:hover :global(.arrow) { color: var(--accent); transform: translateX(2px); }

  @media (max-width: 700px) {
    .row {
      grid-template-columns: minmax(0, 1fr) 14px;
      grid-template-areas: "name arrow" "blurb blurb" "meta meta";
      gap: 4px 12px;
    }
  }
</style>
