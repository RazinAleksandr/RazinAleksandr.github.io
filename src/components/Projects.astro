---
/**
 * Repositories as small cards. Star counts come from the GitHub API at build
 * time and fall back to the snapshot in projects.ts when it is unreachable.
 */
import { projects } from "../data/projects";
import { liveStars } from "../lib/stars";
import Icon from "./Icon.astro";

const stars = await liveStars();
const owner = (p: (typeof projects)[number]) => p.owner ?? "RazinAleksandr";
const list = projects.map((p) => ({
  ...p,
  url: p.href ?? `https://github.com/${owner(p)}/${p.repo}`,
  count: p.owner ? p.stars : (stars[p.repo] ?? p.stars),
}));
---

<section class="section" id="projects">
  <h2>Projects</h2>
  <ul class="grid">
    {list.map((p) => (
      <li>
        <a class="card" href={p.url} target="_blank" rel="noopener">
          <span class="head">
            <span class="name">{p.name}</span>
            {p.count > 0 && <span class="stars mono"><Icon name="star" size={11} /> {p.count}</span>}
          </span>
          <span class="blurb">{p.blurb}</span>
          <span class="meta mono">{owner(p)}/{p.repo} · {p.lang}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .card {
    display: grid; gap: 6px; height: 100%;
    padding: 16px 18px;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
    color: var(--ink);
    transition: background .2s, border-color .2s;
  }
  .card:hover { background: var(--card-2); border-color: var(--line-2); color: var(--ink); }
  .head { display: flex; align-items: baseline; gap: 10px; }
  .name { font-size: 19px; font-weight: 500; }
  .card:hover .name { color: var(--rose); }
  .stars { margin-left: auto; display: inline-flex; align-items: center; gap: 4px; color: var(--accent); white-space: nowrap; }
  .blurb { font-size: 15.5px; line-height: 1.5; color: var(--ink-2); }
  .meta { font-size: 11.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
