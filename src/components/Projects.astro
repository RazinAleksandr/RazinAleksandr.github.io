---
/**
 * Selected repositories. Star counts come from the GitHub API at build time
 * and fall back to the snapshot in projects.ts when the API is unavailable.
 */
import { projects } from "../data/projects";
import { liveStars } from "../lib/stars";
import Icon from "./Icon.astro";

const stars = await liveStars();
const owner = (p: (typeof projects)[number]) => p.owner ?? "RazinAleksandr";
const list = projects.map((p) => ({
  ...p,
  url: p.href ?? `https://github.com/${owner(p)}/${p.repo}`,
  count: p.owner ? p.stars : (stars[p.repo] ?? p.stars),
}));
---

<section class="section" id="projects">
  <h2>Projects</h2>

  <ul class="grid">
    {list.map((p) => (
      <li>
        <div class="head">
          <a href={p.url} target="_blank" rel="noopener">{p.name}</a>
          {p.count > 0 && <span class="stars mono"><Icon name="star" size={11} /> {p.count}</span>}
        </div>
        <p class="blurb">{p.blurb}</p>
        <span class="meta mono">{owner(p)}/{p.repo} · {p.lang}</span>
      </li>
    ))}
  </ul>

  <p class="more">
    <a href="https://github.com/RazinAleksandr?tab=repositories" target="_blank" rel="noopener">All repositories on GitHub</a>
  </p>
</section>

<style>
  .grid {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 32px;
  }
  .grid li { padding: 14px 0; border-top: 1px solid var(--line); }
  .grid li:nth-child(-n + 2) { border-top: 0; padding-top: 0; }

  .head { display: flex; align-items: baseline; gap: 10px; }
  .head a { color: var(--ink); font-weight: 600; font-size: 15.5px; }
  .head a:hover { color: var(--accent); text-decoration: none; }
  .stars { margin-left: auto; display: inline-flex; align-items: center; gap: 4px; font-size: 12px; white-space: nowrap; }

  .blurb { margin-top: 4px; font-size: 14.5px; line-height: 1.5; color: var(--muted); }
  .meta { display: block; margin-top: 6px; font-size: 11.5px; color: var(--faint); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .more { margin-top: 22px; font-size: 14px; }

  @media (max-width: 620px) {
    .grid { grid-template-columns: 1fr; }
    .grid li:nth-child(2) { border-top: 1px solid var(--line); padding-top: 14px; }
  }
</style>
