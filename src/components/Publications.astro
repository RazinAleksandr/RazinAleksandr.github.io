---
/**
 * Papers as cards: the figure on the left with the venue as a badge over its
 * corner, the detail on the right. Every paper gets the same card.
 */
import { publications } from "../data/publications";

const base = import.meta.env.BASE_URL;
const src = (p: string) => `${base}${p}`.replace(/\/{2,}/g, "/");
---

<section class="section" id="papers">
  <h2>Publications</h2>
  <ul class="pubs">
    {publications.map((p, i) => (
      <li class="card">
        <a class="fig" href={p.links[0]?.href ?? "#"} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
          <span class="badge">{p.venue} {p.year}</span>
          {p.image && <img src={src(p.image)} alt="" />}
        </a>
        <div class="text">
          <h3 class="title">
            {p.links[0] ? <a href={p.links[0].href} target="_blank" rel="noopener">{p.title}</a> : p.title}
          </h3>
          <p class="authors">
            {p.authors.map((a, k) => <>{k > 0 && ", "}{a.me ? <b>{a.name}</b> : a.name}</>)}
          </p>
          {p.note && <p class="note">{p.note}</p>}
          <div class="links">
            {p.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
            <button type="button" data-bib={i} aria-expanded="false">BibTeX</button>
          </div>
          <pre class="bib" id={`bib-${i}`} hidden><code>{p.bibtex}</code></pre>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .pubs { display: grid; gap: 18px; }
  .card {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 24px;
    padding: 20px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    align-items: start;
    transition: background .2s, border-color .2s;
  }
  .card:hover { background: var(--card-2); border-color: var(--line-2); }

  .fig { position: relative; display: block; border-radius: 8px; overflow: hidden; background: #fff; box-shadow: var(--shadow); }
  .fig img { width: 100%; aspect-ratio: 5 / 3; object-fit: cover; }
  .badge {
    position: absolute; top: 10px; left: -4px; z-index: 1;
    padding: 4px 12px 4px 14px;
    font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase;
    color: #fff; background: var(--badge);
    border-radius: 0 6px 6px 0;
    box-shadow: 0 4px 12px rgba(0, 0, 0, .3);
  }

  .title { font-size: 20px; font-weight: 500; line-height: 1.3; text-wrap: pretty; }
  .title a { color: var(--ink); }
  .title a:hover { color: var(--rose); }
  .authors { margin-top: 8px; font-size: 15.5px; color: var(--muted); }
  .authors b { color: var(--ink); font-weight: 600; text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 3px; }
  .note { margin-top: 6px; font-size: 15px; color: var(--rose); font-style: italic; }
  .links { margin-top: 12px; }

  .bib {
    margin: 12px 0 0; padding: 12px 14px;
    background: rgba(0, 0, 0, .35); border: 1px solid var(--line); border-radius: 8px;
    overflow-x: auto; font-family: var(--mono); font-size: 12px; line-height: 1.5; color: var(--ink-2);
  }

  @media (max-width: 640px) {
    .card { grid-template-columns: 1fr; gap: 14px; padding: 14px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("button[data-bib]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const pre = document.getElementById(`bib-${btn.dataset.bib}`);
      if (!pre) return;
      pre.hidden = !pre.hidden;
      btn.setAttribute("aria-expanded", String(!pre.hidden));
    });
  });
</script>
