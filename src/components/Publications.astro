---
/**
 * Papers, thumbnail on the left, detail on the right. A paper without a
 * figure gets a plain wash panel with its venue, so the column stays aligned.
 */
import { publications } from "../data/publications";

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${p}`.replace(/\/{2,}/g, "/");
---

<section class="section" id="publications">
  <h2>Publications</h2>

  <ol class="pubs">
    {publications.map((p, i) => (
      <li class="pub">
        {p.image ? (
          <a class="thumb" href={p.links[0]?.href ?? "#"} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
            <img src={href(p.image)} alt="" loading="lazy" decoding="async" width="1200" height="722" />
          </a>
        ) : (
          <div class="thumb blank" aria-hidden="true"><span>{p.venue}<br />{p.year}</span></div>
        )}

        <div class="meat">
          <h3>
            {p.links[0] ? <a href={p.links[0].href} target="_blank" rel="noopener">{p.title}</a> : p.title}
          </h3>
          <p class="authors">
            {p.authors.map((a, k) => (
              <>{k > 0 && ", "}{a.me ? <b>{a.name}</b> : a.name}</>
            ))}
          </p>
          <p class="venue">
            <b>{p.venue} {p.year}</b>{p.note && <> · {p.note}</>}
          </p>
          <p class="abs">{p.abstract}</p>
          {(p.links.length > 0 || p.bibtex) && (
            <div class="links">
              {p.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
              {p.bibtex && <button type="button" data-bib={i} aria-expanded="false">BibTeX</button>}
            </div>
          )}
          {p.bibtex && <pre class="bib" id={`bib-${i}`} hidden><code>{p.bibtex}</code></pre>}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .pubs { list-style: none; margin: 0; padding: 0; }
  .pub {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 22px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  .pub:first-child { border-top: 0; padding-top: 0; }

  .thumb {
    display: block;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--card);
    align-self: start;
  }
  .thumb img { width: 100%; height: auto; }
  .thumb.blank {
    aspect-ratio: 1200 / 722;
    display: grid; place-items: center;
    background: var(--wash);
    color: var(--faint);
    font-family: var(--serif); font-style: italic; font-size: 14px;
    text-align: center; line-height: 1.4; padding: 10px;
  }

  h3 { font-family: var(--sans); font-size: 16px; font-weight: 600; line-height: 1.4; }
  h3 a { color: var(--ink); }
  h3 a:hover { color: var(--accent); text-decoration: none; }
  .authors { margin-top: 5px; font-size: 14px; color: var(--muted); }
  .authors b { color: var(--ink); font-weight: 600; }
  .venue { margin-top: 3px; font-size: 14px; color: var(--muted); }
  .venue b { color: var(--ink); font-weight: 600; }
  .abs { margin-top: 8px; font-size: 14.5px; line-height: 1.55; color: var(--muted); }
  .links { margin-top: 9px; }

  .bib {
    margin: 12px 0 0; padding: 12px 14px;
    background: var(--wash);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow-x: auto;
    font-family: var(--mono); font-size: 12px; line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 620px) {
    .pub { grid-template-columns: 1fr; gap: 12px; }
    .thumb { max-width: 320px; }
    .thumb.blank { display: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("button[data-bib]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const pre = document.getElementById(`bib-${btn.dataset.bib}`);
      if (!pre) return;
      pre.hidden = !pre.hidden;
      btn.setAttribute("aria-expanded", String(!pre.hidden));
    });
  });
</script>
