---
/**
 * Publications: the paper's own figure across the top, then the detail, with
 * my name bolded in the author list. The figure runs full width because these
 * are wide multi-panel figures — squeezed into a side column they lose the
 * panels that carry the argument. BibTeX folds away so it never competes with
 * the abstract, but is one click from every entry that has one.
 */
import { publications } from "../data/publications";
---

<section class="section" id="papers">
  <h2 class="sec-title"><span class="idx">03</span> Papers</h2>

  <ol class="pubs">
    {publications.map((p, i) => (
      <li class="pub card">
        {p.image && (
          <a class="thumb" href={p.links[0]?.href ?? "#"} target="_blank" rel="noopener">
            <img src={p.image} alt={`Figure from “${p.title}”`} loading="lazy" decoding="async" />
          </a>
        )}

        <div class="meat">
          <h3 class="title">
            {p.links[0] ? (
              <a href={p.links[0].href} target="_blank" rel="noopener">{p.title}</a>
            ) : (
              p.title
            )}
          </h3>

          <p class="authors">
            {p.authors.map((a, k) => (
              <>
                {k > 0 && ", "}
                {a.me ? <b>{a.name}</b> : <span>{a.name}</span>}
              </>
            ))}
          </p>

          <div class="badges">
            {p.badges.map((b) => <span class={`pill tone-${b.tone}`}>{b.label}</span>)}
          </div>

          <p class="abs">{p.abstract}</p>

          <div class="foot">
            <div class="linkrow">
              {p.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener">{l.label}</a>
              ))}
            </div>
            {p.bibtex && (
              <button class="bib-toggle" type="button" data-bib={i} aria-expanded="false">
                BibTeX
              </button>
            )}
          </div>

          {p.bibtex && (
            <pre class="bib" id={`bib-${i}`} hidden><code>{p.bibtex}</code></pre>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .pubs { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }

  .pub { display: block; overflow: hidden; }

  .thumb {
    display: block;
    line-height: 0;
    background: var(--surface-2);
    border-bottom: 1px solid var(--rule-soft);
  }
  .thumb img {
    width: 100%;
    height: auto;
    aspect-ratio: 1600 / 963;
    object-fit: contain;
    display: block;
  }

  .meat { padding: 16px 17px 17px; min-width: 0; }

  .title {
    margin: 0;
    font-size: 17px;
    line-height: 1.3;
    font-variation-settings: "wdth" 106, "wght" 660;
    text-wrap: balance;
  }
  .title a { text-decoration: none; }
  .title a:hover { color: var(--accent); }

  .authors { margin: 8px 0 0; font-size: 13.5px; color: var(--ink-3); }
  .authors b { color: var(--ink); font-weight: 600; }

  .badges { margin-top: 10px; display: flex; flex-wrap: wrap; gap: 6px; }

  .abs { margin: 11px 0 0; font-size: 14px; line-height: 1.55; color: var(--ink-2); }

  .foot {
    margin-top: 14px;
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }
  .bib-toggle {
    font-family: var(--font-m);
    font-size: 11px;
    letter-spacing: .05em;
    color: var(--ink-2);
    background: transparent;
    border: 1px dashed var(--rule);
    border-radius: 999px;
    padding: 5px 11px;
    cursor: pointer;
  }
  .bib-toggle:hover { color: var(--ink); border-color: var(--accent); }

  .bib {
    margin: 12px 0 0;
    padding: 12px;
    background: var(--ground);
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-sm);
    overflow-x: auto;
    font-family: var(--font-m);
    font-size: 11px;
    line-height: 1.5;
    color: var(--ink-2);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".bib-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const pre = document.getElementById(`bib-${btn.dataset.bib}`);
      if (!pre) return;
      const open = !pre.hidden;
      pre.hidden = open;
      btn.setAttribute("aria-expanded", String(!open));
      btn.textContent = open ? "BibTeX" : "Hide BibTeX";
    });
  });
</script>
