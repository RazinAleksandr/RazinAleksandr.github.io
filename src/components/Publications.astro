---
/**
 * Papers, one row each: thumbnail, venue, title, authors, links. Every paper
 * gets the same treatment; the venue line is where one stands out.
 */
import { publications } from "../data/publications";

const base = import.meta.env.BASE_URL;
const src = (p: string) => `${base}${p}`.replace(/\/{2,}/g, "/");
---

<section class="section" id="papers">
  <p class="label">Papers</p>

  <ul class="pubs">
    {publications.map((p, i) => (
      <li>
        {p.image && (
          <a class="thumb" href={p.links[0]?.href ?? "#"} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
            <img src={src(p.image)} alt="" decoding="async" />
          </a>
        )}
        <div class="text">
          <p class="label venue">{p.venue} {p.year}{p.note && <> · {p.note}</>}</p>
          <h3 class="title">
            {p.links[0] ? <a href={p.links[0].href} target="_blank" rel="noopener">{p.title}</a> : p.title}
          </h3>
          <p class="authors">
            {p.authors.map((a, k) => <>{k > 0 && ", "}{a.me ? <b>{a.name}</b> : a.name}</>)}
          </p>
          {(p.links.length > 0 || p.bibtex) && (
            <div class="links">
              {p.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
              {p.bibtex && <button type="button" data-bib={i} aria-expanded="false">BibTeX</button>}
            </div>
          )}
          {p.bibtex && <pre class="bib" id={`bib-${i}`} hidden><code>{p.bibtex}</code></pre>}
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .pubs { display: grid; }
  .pubs li {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 24px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
    align-items: start;
  }
  .pubs li:first-child { border-top: 0; padding-top: 0; }

  .thumb { display: block; border: 1px solid var(--line); background: #fff; overflow: hidden; }
  .thumb img { width: 100%; aspect-ratio: 5 / 3; object-fit: cover; }

  .venue { margin-bottom: 6px; }
  .title { font-size: 17px; font-weight: 500; line-height: 1.4; text-wrap: pretty; }
  .title a { color: var(--ink); transition: color .15s; }
  .title a:hover { color: var(--accent); }
  .authors { margin-top: 5px; font-size: 14px; color: var(--muted); }
  .authors b { color: var(--ink); font-weight: 500; }
  .links { margin-top: 9px; font-size: 13.5px; }

  .bib {
    margin: 12px 0 0; padding: 12px 14px;
    background: var(--paper-2); border: 1px solid var(--line);
    overflow-x: auto; font-family: var(--mono); font-size: 12px; line-height: 1.5; color: var(--ink-2);
  }

  @media (max-width: 600px) {
    .pubs li { grid-template-columns: 110px minmax(0, 1fr); gap: 14px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("button[data-bib]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const pre = document.getElementById(`bib-${btn.dataset.bib}`);
      if (!pre) return;
      pre.hidden = !pre.hidden;
      btn.setAttribute("aria-expanded", String(!pre.hidden));
    });
  });
</script>
