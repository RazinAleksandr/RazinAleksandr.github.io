---
/** The bio. Who, where now and on what (bold), where before, degree. */
import { profile } from "../data/profile";
import { inlineMd } from "../lib/inline";
---

<section class="section about" id="about">
  <h2>About me</h2>
  <div class="bio">
    {profile.intro.map((para) => <p set:html={inlineMd(para)} />)}
  </div>
</section>

<style>
  .about { padding-top: 0; }
  .bio { display: grid; gap: 16px; font-size: 19px; line-height: 1.6; color: var(--ink-2); }
  .bio :global(strong) { color: var(--ink); font-weight: 600; }
  .bio :global(a) { color: var(--accent); border-bottom: 1px solid var(--line-2); }
  .bio :global(a:hover) { color: var(--rose); border-color: var(--rose); }
</style>
