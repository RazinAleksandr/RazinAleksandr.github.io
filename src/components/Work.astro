---
/**
 * Where I've worked: a wordmark strip that reads at a glance, then the detail.
 *
 * The strip uses typographic wordmarks rather than company logo files — it
 * keeps the row visually consistent and ships no third-party trademarks. Add
 * `logo:` to a role in experience.ts and it is used instead.
 */
import { experience, education } from "../data/experience";
---

<section class="section" id="work">
  <h2 class="sec-title"><span class="idx">02</span> Where I've worked</h2>

  <div class="strip" aria-hidden="true">
    {experience.map((r) => (
      <span class={`mark tone-${r.tone}`}>
        {r.logo ? <img src={r.logo} alt="" height="22" /> : r.mark}
      </span>
    ))}
  </div>

  <ol class="roles">
    {experience.map((r) => (
      <li class={`role tone-${r.tone}`}>
        <div class="when mono">
          {r.from}{r.to !== r.from ? `–${r.to === "now" ? "" : r.to}` : ""}
        </div>
        <div class="what">
          <h3 class="org">
            <span class="bead" aria-hidden="true" />
            {r.href ? <a href={r.href} target="_blank" rel="noopener">{r.org}</a> : r.org}
            {r.where && <span class="loc mono">{r.where}</span>}
          </h3>
          <div class="title mono">{r.role}</div>
          <p class="sum">{r.summary}</p>
          <ul class="points">
            {r.points.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </li>
    ))}
  </ol>

  <div class="edu">
    {education.map((e) => (
      <div class="degree">
        <span class="deg mono">{e.degree}</span>
        <div>
          <b>{e.org}</b> — {e.field} <span class="yrs mono">{e.years}</span>
          <div class="note">{e.note}</div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 16px;
    margin-bottom: 26px;
    background: var(--surface);
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-md);
    justify-content: center;
  }
  .mark {
    font-family: var(--font-d);
    font-variation-settings: "wdth" 108, "wght" 680;
    font-size: 15px;
    letter-spacing: -.01em;
    padding: 6px 13px;
    border-radius: var(--r-sm);
    color: var(--ink);
    background: color-mix(in srgb, var(--c, var(--accent)) 16%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c, var(--accent)) 38%, transparent);
    white-space: nowrap;
  }

  .roles { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .role {
    display: grid;
    grid-template-columns: 82px minmax(0, 1fr);
    gap: 18px;
    padding: 18px 0;
    border-top: 1px solid var(--rule-soft);
  }
  .role:first-child { border-top: 0; padding-top: 4px; }

  .when {
    font-size: 11px;
    letter-spacing: .04em;
    text-transform: none;
    color: var(--ink-3);
    padding-top: 4px;
    white-space: nowrap;
  }

  .org {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
    margin: 0;
    font-size: 18px;
    font-variation-settings: "wdth" 110, "wght" 680;
    line-height: 1.2;
  }
  .org a { text-decoration: none; }
  .org a:hover { color: var(--accent); }
  .bead {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--c, var(--accent));
    flex: none;
  }
  .loc { text-transform: none; font-size: 10.5px; letter-spacing: .05em; }

  .title {
    margin-top: 4px;
    font-size: 10.5px;
    letter-spacing: .1em;
    color: var(--ink-3);
  }
  .sum { margin: 9px 0 0; font-size: 15px; line-height: 1.55; color: var(--ink-2); }

  .points { margin: 9px 0 0; padding: 0; list-style: none; display: grid; gap: 5px; }
  .points li {
    position: relative;
    padding-left: 16px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .points li::before {
    content: "";
    position: absolute;
    left: 3px;
    top: .62em;
    width: 5px;
    height: 1px;
    background: var(--c, var(--accent));
  }

  .edu {
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 14px;
  }
  .degree { display: flex; gap: 14px; align-items: baseline; font-size: 14.5px; color: var(--ink-2); }
  .degree b { color: var(--ink); font-weight: 600; }
  .deg {
    font-size: 10px;
    letter-spacing: .1em;
    color: var(--accent);
    flex: none;
    width: 42px;
  }
  .yrs { text-transform: none; font-size: 10.5px; }
  .note { font-size: 13.5px; color: var(--ink-3); margin-top: 3px; }

  @media (max-width: 620px) {
    .role { grid-template-columns: 1fr; gap: 6px; }
    .when { padding-top: 0; }
    .strip { justify-content: flex-start; }
  }
</style>
