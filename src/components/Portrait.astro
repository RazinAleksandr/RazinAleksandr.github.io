---
/**
 * The portrait as a loop of two states: noise, as a latent before sampling,
 * and the photograph, as its decode. The noise is drawn in the paper's own
 * two tones so it belongs to the page; the photograph is the only colour.
 *
 * Noise (hold) → denoise → photograph (hold) → back to noise, about seven
 * seconds a loop. It pauses off-screen and in a hidden tab, and with reduced
 * motion the photograph is simply there.
 */
interface Props { src: string; alt: string }
const { src, alt } = Astro.props;
---

<div class="portrait" id="portrait">
  <img src={src} alt={alt} id="portraitImg" width="900" height="900" fetchpriority="high" />
  <canvas id="portraitCv" aria-hidden="true"></canvas>
</div>

<style>
  .portrait {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--paper-2);
  }
  .portrait img, .portrait canvas {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .portrait canvas { opacity: 0; }
</style>

<script>
  const box = document.getElementById("portrait");
  const img = document.getElementById("portraitImg") as HTMLImageElement | null;
  const cv = document.getElementById("portraitCv") as HTMLCanvasElement | null;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (box && img && cv && !reduced) {
    const ctx = cv.getContext("2d")!;
    const GRAIN = 2;              // css px per noise cell
    const INK = [17, 17, 17], PAPER = [243, 240, 232];

    // timeline, ms
    const NOISE = 1400, DENOISE = 2200, PHOTO = 3000, RENOISE = 700;
    const LOOP = NOISE + DENOISE + PHOTO + RENOISE;

    const ease = (v: number) => { v = Math.max(0, Math.min(1, v)); return v * v * (3 - 2 * v); };

    let side = 0;
    let noise: HTMLCanvasElement | null = null;
    let nctx: CanvasRenderingContext2D | null = null;
    let data: ImageData | null = null;

    function size() {
      const css = box!.clientWidth;
      if (!css) return false;
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const px = Math.round(css * dpr);
      if (px !== cv!.width) { cv!.width = px; cv!.height = px; }
      const n = Math.max(24, Math.round(css / GRAIN));
      if (n !== side) {
        side = n;
        noise = document.createElement("canvas");
        noise.width = n; noise.height = n;
        nctx = noise.getContext("2d")!;
        data = nctx.createImageData(n, n);
      }
      return true;
    }

    // Gaussian-ish grey noise between ink and paper — three uniforms summed,
    // which is enough bell for the eye.
    function drawNoise() {
      const p = data!.data;
      for (let i = 0; i < p.length; i += 4) {
        const t = (Math.random() + Math.random() + Math.random()) / 3;
        p[i]     = INK[0] + (PAPER[0] - INK[0]) * t;
        p[i + 1] = INK[1] + (PAPER[1] - INK[1]) * t;
        p[i + 2] = INK[2] + (PAPER[2] - INK[2]) * t;
        p[i + 3] = 255;
      }
      nctx!.putImageData(data!, 0, 0);
      ctx.imageSmoothingEnabled = false;
      ctx.drawImage(noise!, 0, 0, cv!.width, cv!.height);
    }

    let raf = 0;
    let t0 = 0;
    let running = false;
    let lastNoiseAt = -1;

    function frame(now: number) {
      if (!running) return;
      if (!size()) { raf = requestAnimationFrame(frame); return; }
      const t = (now - t0) % LOOP;

      let noiseA = 0, photoBlur = 0, photoA = 1;
      if (t < NOISE) {
        noiseA = 1; photoA = 0;
      } else if (t < NOISE + DENOISE) {
        const p = ease((t - NOISE) / DENOISE);
        noiseA = 1 - ease(Math.min(1, p * 1.25));
        photoA = ease(Math.min(1, p * 1.6));
        photoBlur = (1 - p) * 22;
      } else if (t < NOISE + DENOISE + PHOTO) {
        noiseA = 0; photoA = 1;
      } else {
        const p = ease((t - NOISE - DENOISE - PHOTO) / RENOISE);
        noiseA = p; photoA = 1; photoBlur = p * 10;
      }

      // the grain flickers at ~24 fps, not 60 — calmer, and cheaper
      if (noiseA > 0 && now - lastNoiseAt > 40) { drawNoise(); lastNoiseAt = now; }
      cv!.style.opacity = noiseA.toFixed(3);
      img!.style.opacity = photoA.toFixed(3);
      img!.style.filter = photoBlur > 0.3 ? `blur(${photoBlur.toFixed(1)}px)` : "";

      raf = requestAnimationFrame(frame);
    }

    function start() {
      if (running) return;
      running = true;
      t0 = performance.now();
      raf = requestAnimationFrame(frame);
    }
    function stop() {
      running = false;
      cancelAnimationFrame(raf);
      cv!.style.opacity = "0";
      img!.style.opacity = "1";
      img!.style.filter = "";
    }

    const io = new IntersectionObserver(([e]) => (e.isIntersecting && !document.hidden ? start() : stop()), { threshold: 0.2 });
    io.observe(box);
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
  }
</script>
