---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { readingTime, formatDate } from "../../lib/post";

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${p}`.replace(/\/{2,}/g, "/");

const posts = (await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base current="blog" title="Blog — Aleksandr Razin" description="Notes on generative vision, image restoration and shipping ML.">
  <section class="section">
    <h2>Blog</h2>
    <p class="sub">Notes on generative vision, image restoration, and what survives contact with production.</p>

    {posts.length === 0 ? (
      <p class="empty">Nothing here yet. The <a href={href("#publications")}>papers</a> and
        <a href={href("#projects")}>projects</a> are the shortest route to what I work on.</p>
    ) : (
      <ol class="posts">
        {posts.map((p) => (
          <li>
            <p class="meta mono">
              <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
              · {readingTime(p.body ?? "")} min read
              {p.data.draft && <> · draft</>}
            </p>
            <h3><a href={href(`blog/${p.id}`)}>{p.data.title}</a></h3>
            <p class="excerpt">{p.data.description}</p>
          </li>
        ))}
      </ol>
    )}
  </section>
</Base>

<style>
  .sub { margin-top: -8px; color: var(--muted); font-size: 15.5px; max-width: 56ch; }
  .empty { margin-top: 28px; color: var(--muted); font-size: 15.5px; }
  .posts { list-style: none; margin: 28px 0 0; padding: 0; display: grid; }
  .posts li { padding: 20px 0; border-top: 1px solid var(--line); }
  .posts li:first-child { border-top: 0; padding-top: 0; }
  h3 { margin-top: 4px; font-size: 21px; }
  h3 a { color: var(--ink); }
  h3 a:hover { color: var(--accent); text-decoration: none; }
  .excerpt { margin-top: 6px; color: var(--muted); font-size: 15px; line-height: 1.6; max-width: 66ch; }
</style>
