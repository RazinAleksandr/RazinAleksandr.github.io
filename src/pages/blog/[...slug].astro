---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { readingTime, formatDate } from "../../lib/post";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props;
const { Content } = await render(post);

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${p}`.replace(/\/{2,}/g, "/");
---

<Base current="blog" title={`${post.data.title} — Aleksandr Razin`} description={post.data.description}>
  <article class="section post">
    <a class="back" href={href("blog")}><Icon name="arrowl" size={14} /> All posts</a>

    <header>
      <p class="meta mono">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        · {readingTime(post.body ?? "")} min read
        {post.data.draft && <> · draft</>}
      </p>
      <h1>{post.data.title}</h1>
      <p class="desc">{post.data.description}</p>
      {post.data.tags.length > 0 && <p class="tags mono">{post.data.tags.join(" · ")}</p>}
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .back { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; color: var(--muted); margin-bottom: 26px; }
  .back:hover { color: var(--accent); text-decoration: none; }

  h1 { margin-top: 6px; font-size: clamp(28px, 5vw, 36px); text-wrap: balance; }
  .desc { margin-top: 12px; font-family: var(--serif); font-size: 18px; line-height: 1.5; color: var(--muted); }
  .tags { margin-top: 10px; }

  .prose {
    margin-top: 30px; padding-top: 26px;
    border-top: 1px solid var(--line);
    font-size: 16.5px; line-height: 1.7; color: var(--ink);
  }
  .prose :global(h2) { margin: 36px 0 12px; font-size: 24px; }
  .prose :global(h3) { margin: 28px 0 10px; font-size: 19px; }
  .prose :global(p) { margin: 0 0 16px; }
  .prose :global(a) { color: var(--accent); }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 16px; padding-left: 22px; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(img) { border-radius: 8px; border: 1px solid var(--line); }
  .prose :global(blockquote) {
    margin: 0 0 16px; padding: 2px 0 2px 16px;
    border-left: 2px solid var(--accent);
    font-family: var(--serif); font-style: italic; color: var(--muted);
  }
  .prose :global(code) {
    font-family: var(--mono); font-size: .88em;
    background: var(--wash); border: 1px solid var(--line); border-radius: 4px; padding: 1px 5px;
  }
  .prose :global(pre) {
    margin: 0 0 18px; padding: 14px 16px;
    background: var(--wash); border: 1px solid var(--line); border-radius: 8px;
    overflow-x: auto; font-size: 13px; line-height: 1.6;
  }
  .prose :global(pre code) { background: none; border: 0; padding: 0; font-size: inherit; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 18px; font-size: 14.5px; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); }
  .prose :global(th) { font-weight: 600; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 32px 0; }
</style>
