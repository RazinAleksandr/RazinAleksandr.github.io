---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { readingTime, formatDate } from "../../lib/post";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props;
const { Content } = await render(post);

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${p}`.replace(/\/{2,}/g, "/");
---

<Base title={`${post.data.title} — Aleksandr Razin`} description={post.data.description}>
  <article class="wrap post">
    <a class="back mono" href={href("blog")}>← all posts</a>

    <header>
      <div class="meta mono">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span class="dot">●</span>
        <span>Read time ~{readingTime(post.body ?? "")} min</span>
        {post.data.draft && <span class="draft">draft</span>}
      </div>
      <h1>{post.data.title}</h1>
      <p class="desc">{post.data.description}</p>
      {post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((t) => <span class="pill tone-cyan">{t}</span>)}
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post { padding-block: 28px 20px; max-width: 760px; }

  .back { display: inline-block; text-decoration: none; margin-bottom: 26px; }
  .back:hover { color: var(--ink); }

  .meta {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 11px;
    letter-spacing: .05em;
    text-transform: none;
    flex-wrap: wrap;
  }
  .dot { font-size: 7px; color: var(--ink-3); }
  .draft {
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 1px 7px;
    font-size: 9px;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  h1 {
    margin: 12px 0 0;
    font-size: clamp(28px, 6.4vw, 42px);
    line-height: 1.08;
    letter-spacing: -.024em;
    font-variation-settings: "wdth" 114, "wght" 740;
    text-wrap: balance;
  }
  .desc { margin: 14px 0 0; font-size: 17px; line-height: 1.6; color: var(--ink-2); }
  .tags { margin-top: 14px; display: flex; gap: 6px; flex-wrap: wrap; }

  .prose {
    margin-top: 34px;
    padding-top: 30px;
    border-top: 1px solid var(--rule);
    font-size: 16.5px;
    line-height: 1.72;
    color: var(--ink-2);
  }
  .prose :global(h2) {
    margin: 38px 0 12px;
    font-size: 24px;
    line-height: 1.2;
    color: var(--ink);
    font-variation-settings: "wdth" 110, "wght" 700;
    letter-spacing: -.015em;
  }
  .prose :global(h3) {
    margin: 28px 0 10px;
    font-size: 19px;
    color: var(--ink);
    font-variation-settings: "wdth" 108, "wght" 660;
  }
  .prose :global(p) { margin: 0 0 18px; }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }
  .prose :global(a) { color: var(--accent); text-underline-offset: 3px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 18px; padding-left: 22px; }
  .prose :global(li) { margin-bottom: 7px; }
  .prose :global(img) { border-radius: var(--r-md); border: 1px solid var(--rule-soft); }
  .prose :global(blockquote) {
    margin: 0 0 18px;
    padding: 2px 0 2px 16px;
    border-left: 2px solid var(--accent);
    color: var(--ink-2);
  }
  .prose :global(code) {
    font-family: var(--font-m);
    font-size: .88em;
    background: var(--surface);
    border: 1px solid var(--rule-soft);
    border-radius: 4px;
    padding: 1px 5px;
  }
  .prose :global(pre) {
    margin: 0 0 20px;
    padding: 14px 16px;
    background: var(--surface);
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-md);
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.6;
  }
  .prose :global(pre code) { background: none; border: 0; padding: 0; font-size: inherit; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 20px; font-size: 14.5px; }
  .prose :global(th), .prose :global(td) {
    text-align: left;
    padding: 8px 10px;
    border-bottom: 1px solid var(--rule-soft);
  }
  .prose :global(th) { color: var(--ink); font-weight: 600; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--rule); margin: 32px 0; }
</style>
