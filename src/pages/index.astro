---
import Base from "../layouts/Base.astro";
import LatentHero from "../components/LatentHero.astro";
import Metrics from "../components/Metrics.astro";
import News from "../components/News.astro";
import Work from "../components/Work.astro";
import Publications from "../components/Publications.astro";
import Projects from "../components/Projects.astro";
---

<Base bare>
  <LatentHero />

  <div class="wrap metrics-wrap">
    <Metrics />
  </div>

  <div class="wrap">
    <News />
    <Work />
    <Publications />
    <Projects />
  </div>
</Base>

<style>
  .metrics-wrap { padding-block: 10px 0; }
</style>
