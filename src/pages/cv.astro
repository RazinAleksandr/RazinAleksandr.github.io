---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { profile } from "../data/profile";

const base = import.meta.env.BASE_URL;
const pdf = `${base}${profile.cv.file}`.replace(/\/{2,}/g, "/");
---

<Base current="cv" title={`CV — ${profile.name}`} description={`Curriculum vitae of ${profile.name} (PDF).`}>
  <section class="section cv">
    <h2>
      Curriculum vitae
      <span class="side">
        <span class="mono">Updated {profile.cv.updated}</span>
        <a class="dl" href={pdf} download><Icon name="download" size={14} /> Download PDF</a>
      </span>
    </h2>
    <object class="pdf" data={`${pdf}#view=FitH`} type="application/pdf" aria-label="CV as PDF">
      <p class="fallback">Your browser does not preview PDFs here — <a href={pdf} target="_blank" rel="noopener">open the CV</a> in a new tab.</p>
    </object>
  </section>
</Base>

<style>
  .cv { padding-top: 0; }
  .cv > h2 { display: flex; align-items: baseline; justify-content: space-between; gap: 18px; flex-wrap: wrap; }
  .side { display: inline-flex; align-items: center; gap: 16px; }
  .dl {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--serif); font-size: 14px; font-weight: 500;
    color: var(--bg-0); background: var(--accent);
    padding: 8px 15px; border-radius: 999px;
    transition: background .15s;
  }
  .dl:hover { background: var(--rose); color: var(--bg-0); }
  .pdf { display: block; width: 100%; height: min(1180px, calc(100vh - 170px)); border: 1px solid var(--line); border-radius: var(--radius); background: #fff; }
  .fallback { padding: 24px; color: var(--ink-2); }
  @media (max-width: 880px) { .pdf { height: min(900px, calc(100vh - 120px)); } }
</style>
